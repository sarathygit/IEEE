# Vite inlines these at BUILD time, so changing them on Vercel requires a
# redeploy, not just a restart. Leave both unset for local development: the
# client then falls back to http://localhost:8081 and http://localhost:8001.
VITE_SWITCH_URL=https://finguard-switch.onrender.com
VITE_ML_URL=https://finguard-ml.onrender.com
